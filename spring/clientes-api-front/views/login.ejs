<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Autenticação</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body class="login-body">

    <div class="login-container">

        <h1>Autenticação</h1>

        <% if (mensagem) { %>

            <p class="mensagem-erro">
                <%= mensagem %>
            </p>

        <% } %>

        <form
            action="/autenticar"
            method="POST"
            class="login-form"
        >

            <label for="usuario">
                Usuário:
            </label>

            <input
                type="text"
                name="usuario"
                id="usuario"
            >

            <label for="senha">
                Senha:
            </label>

            <input
                type="password"
                name="senha"
                id="senha"
            >

            <button
                type="submit"
                class="entrar"
            >
                Entrar
            </button>

        </form>

    </div>


    <%- include('partials/footer') %>

</body>

</html>
